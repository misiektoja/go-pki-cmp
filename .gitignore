# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env*

# Editor/IDE
.idea/
.vscode/
.cursor/
.cursorignore
.cursorindexingignore
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Tool binaries, build output and caches
bin/
dist/
.cache/
site/

# Dependency directories
vendor/

# Local development and temporary files
/local
tmp/

# Credentials, certificates, keys and backups
*.pem
*.key
*.crt
*.p12
*.jks
*.der
*.token
*.secret
*.bak
*.old
*.orig
# DER encoded CMP messages are golden test vectors, not credentials.
!pkicmp/testdata/*.der
# Bouncy Castle encryption vectors and the RSA test key that decrypts them.
!cms/testdata/kem/*.der
!cms/testdata/encval/*.der
!cms/testdata/encval/rsa-key.pem
# OpenSSL password recipient vectors.
!cms/testdata/pwri/*.der
# OpenSSL key package vectors, the test key they wrap and the signer certificate.
!pkicmp/testdata/keypackage/*.der
!pkicmp/testdata/keypackage/kga.crt

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Integration test state
test/integration/ejbca/testdata/*.pem
test/integration/ejbca/testdata/*.p12
test/integration/cmp-test-suite/reports/
test/integration/cmp-test-suite/config/custom.robot
test/integration/cmp-test-suite/testdata/cmp-test-suite/
